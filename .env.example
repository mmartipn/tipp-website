# Lokale Konfiguration des Tippspiels. Kopie als ".env" anlegen und Werte anpassen.
# Die Datei .env ist per .gitignore ausgeschlossen und darf nie eingecheckt werden.

# Datenbank (MySQL/MariaDB)
DB_HOST=localhost
DB_NAME=tippspiel_demo
DB_USER=example_user
DB_PASSWORD=CHANGE_ME

# Oeffentliche Basis-URL (fuer Links in Aktivierungs- und Passwort-Mails)
APP_URL=http://localhost:8000/

# SMTP fuer Aktivierungs-, Passwort- und Erinnerungsmails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@example.com

# Zahlungshinweise in der Erinnerungsmail an Tipper, die den Einsatz noch nicht bezahlt haben
PAYMENT_PAYPAL=paypal@example.com
PAYMENT_IBAN=DE00 0000 0000 0000 0000 00
PAYMENT_BIC=XXXXXXXXXXX

# Optional: OpenAI-API-Key fuer KI-Autotipps (alternativ Setting "openai_api_key" in set_setting)
OPENAI_API_KEY=

# Hinweis: Zugangsdaten fuer livescore-api.com (api_key, api_secret) sowie cron_secret
# werden in der Tabelle set_setting gepflegt (Admin-Oberflaeche, Menue "Settings").
